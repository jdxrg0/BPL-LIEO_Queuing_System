generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("STAFF") // "ADMIN" or "STAFF"
  createdAt    DateTime @default(now())

  // Catering Permissions
  caterNew        Boolean @default(true)
  caterRenewal    Boolean @default(true)
  caterRetirement Boolean @default(true)
  autoAssign      Boolean @default(true)

  // Relations
  ticketsCreated Ticket[] @relation("TicketCreator")
  ticketsServed  Ticket[] @relation("TicketServer")
  counterId      Int?
  counter        Counter? @relation(fields: [counterId], references: [id])
  
  // Profile
  profilePictureBase64 String?
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String   // "New Application", "Renewal", "Retirement"
  prefix      String   // "NW", "RNW", "R"
  description String?
  isActive    Boolean  @default(true)
  tickets     Ticket[]
  ticketCounters TicketCounter[]
}

model Counter {
  id       Int      @id @default(autoincrement())
  name     String   // "Counter 1", "Window A"
  isActive Boolean  @default(true)
  tickets  Ticket[]
  users    User[]
}

model Ticket {
  id               Int      @id @default(autoincrement())
  number           String   // e.g. "N-001"
  status           String   @default("WAITING") // "WAITING", "SERVING", "COMPLETED", "NO_SHOW"
  createdAt        DateTime @default(now())
  servedAt         DateTime?
  completedAt      DateTime?
  estimatedWaitMins Int?
  priorityType     String   @default("REGULAR") // "REGULAR", "PWD", "SENIOR", "PREGNANT", "RETURNING"
  skipCount        Int      @default(0)
  pushSubscription String?  // Stores stringified Web Push subscription object

  // Relations
  serviceId        Int
  service          Service  @relation(fields: [serviceId], references: [id])
  
  counterId        Int?
  counter          Counter? @relation(fields: [counterId], references: [id])
  
  createdByUserId  Int?
  createdByUser    User?    @relation("TicketCreator", fields: [createdByUserId], references: [id])
  
  servedByUserId   Int?
  servedByUser     User?    @relation("TicketServer", fields: [servedByUserId], references: [id])
}

model Settings {
  id                   Int     @id @default(1)
  websiteName          String  @default("BPLO Queuing System")
  logoBase64           String?
  autoAdaptive         Boolean @default(false)
  autoBalanceThreshold Int     @default(15)
  slaThreshold         Int     @default(15)
  zipperRatio          Int     @default(3)
  agingRate            Float   @default(0.1)
  skipLimit            Int     @default(5)
}

model PriorityGroup {
  id         Int     @id @default(autoincrement())
  name       String  @unique  // e.g. "PWD", "SENIOR", "SOLO_PARENT"
  label      String           // e.g. "Person with Disability", "Senior Citizen"
  shortLabel String?          // e.g. "PWD", "SR" (for compact badge display)
  weight     Int    @default(1) // 0 = regular priority, 1+ = elevated priority
  slaThreshold Int?           // null means use global autoBalanceThreshold
  isActive   Boolean @default(true)
}

model TicketCounter {
  serviceId Int
  date      String   // "MMDDYY" segment of the ticket number
  seq       Int      @default(0)

  service   Service  @relation(fields: [serviceId], references: [id])

  @@id([serviceId, date])
}
