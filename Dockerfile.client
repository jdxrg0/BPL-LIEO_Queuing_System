# Use a lightweight Node.js version 20 image
FROM node:22-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy the client package files first to leverage Docker caching
COPY client/package*.json ./

# Install frontend dependencies
RUN npm ci

# Copy the rest of the frontend source code
COPY client/ .

# Build the React/Vite application for production
# This creates the optimized static files in the /dist folder
RUN npm run build

# Expose port 3000 for the frontend
EXPOSE 3000

# Start the Vite preview server (exactly like your ecosystem.config.js does)
# We add "--host" so the server binds to 0.0.0.0, allowing external access outside the container
CMD ["npm", "run", "preview", "--", "--port", "3000", "--host"]
