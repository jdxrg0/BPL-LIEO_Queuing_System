{
  "name": "bplo-queue-backend",
  "version": "1.0.0",
  "description": "Backend for BPLO Queuing System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "cors": "^2.8.5",
    "@prisma/client": "^5.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "concurrently": "^8.2.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
