{
  "name": "bplo-queue-backend",
  "version": "1.0.0",
  "description": "Backend for BPLO Queuing System",
  "main": "server.js",
  "scripts": {
    "start": "tsx server.ts",
    "server": "tsx watch server.ts",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "tsx prisma/seed.ts",
    "seed:fake": "tsx prisma/fake-data.ts",
    "test": "jest tests/"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.0",
    "@prisma/client": "^5.14.0",
    "@vonage/server-sdk": "^3.30.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pm2": "^7.0.4",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
