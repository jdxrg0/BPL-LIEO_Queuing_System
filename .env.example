# ==========================================
# SERVER ENVIRONMENT VARIABLES (Root .env)
# ==========================================

# Database
DATABASE_URL="file:./prisma/dev.db?connection_limit=1&socket_timeout=5"

# Server Configuration
PORT=5000
# Update this to match your frontend URL in production (e.g. https://your-domain.com)
CLIENT_URL=http://localhost:5173

# Security & Authentication
# Generate a strong 64-character random string for JWT_SECRET
JWT_SECRET=your_super_secret_jwt_key_here
# Generate a string for secret reset key
SECRET_RESET_KEY=your_secret_reset_key_here

# WebPush / VAPID (For Push Notifications)
# Generate via `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Semaphore SMS API
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=SEMAPHORE

# ==========================================
# CLIENT ENVIRONMENT VARIABLES (client/.env)
# ==========================================

# WebPush Public Key (Must match server VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Firebase Configuration (for Firestore real-time tracking)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
